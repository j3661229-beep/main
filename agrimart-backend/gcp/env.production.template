# Production overrides for Google Cloud Run
# Copy values into Cloud Run → Edit & deploy → Environment variables
# Or run: .\scripts\deploy-gcp.ps1 -ProjectId YOUR_ID -SetEnvFromDotEnv

NODE_ENV=production
STATIC_OTP=false
CORS_ORIGIN=*
PORT=3000

GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GROQ_CHAT_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1

# Set after first deploy (Cloud Run service URL):
# PUBLIC_URL=https://agrimart-api-XXXX.asia-south1.run.app

# Required secrets (from your existing .env / Supabase / Groq / etc.):
# DATABASE_URL, DIRECT_URL, SUPABASE_URL, SUPABASE_SERVICE_KEY, JWT_SECRET,
# GROQ_API_KEY, OPENWEATHER_API_KEY, UPSTASH_REDIS_*
