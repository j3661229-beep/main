# ============================================================
# AgriMart Backend — Environment Variables
# ============================================================

# ── Database ────────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres.[REF]:[PASS]@[HOST]:[PORT]/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[REF]:[PASS]@[HOST]:[PORT]/postgres"

# ── Supabase ────────────────────────────────────────────────
# Get from: Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_STORAGE_BUCKET=agrimart-images

# ── JWT Auth ────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Admin ───────────────────────────────────────────────────
# Phone stored in DB, password checked here
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# ── MSG91 OTP (SMS — recommended for India) ─────────────────
# Dashboard: https://control.msg91.com → AuthKey (top) + OTP → Templates
# 1. Complete KYC  2. Create OTP template with ##OTP##  3. Copy template_id
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY_HERE
MSG91_OTP_TEMPLATE_ID=YOUR_OTP_TEMPLATE_ID_HERE
# OTP delivery: msg91 (default) | twilio
OTP_PROVIDER=msg91

# ── Twilio (WhatsApp OTP — optional fallback) ───────────────
# Get from: https://console.twilio.com
# Use WhatsApp Sandbox for dev: +14155238886
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Google Vertex AI (Gemini via ADC — no API key) ───────────
# Auth: gcloud auth application-default login  (local dev)
# Cloud Run: uses attached service account automatically
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
# Optional alias:
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# ── Groq (Kisan AI chat) ────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_CHAT_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# ── Weather API ─────────────────────────────────────────────
# Get from: https://openweathermap.org/api (free tier works)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY_HERE
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ── Mandi Prices (AGMARKNET) ────────────────────────────────
# Get from: https://data.gov.in → Register → Get API key
AGMARKNET_API_URL=https://api.data.gov.in/resource
AGMARKNET_API_KEY=YOUR_AGMARKNET_KEY_HERE

# ── Redis (Caching & Rate Limiting) ─────────────────────────
# Get from: https://upstash.com → Create Redis → REST URL & Token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── OneSignal (Push Notifications) ──────────────────────────
# Get from: https://onesignal.com → Settings → Keys & IDs
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Dev OTP: always 123456, no OTP rate limit. Set STATIC_OTP=false in production.
STATIC_OTP=true
CORS_ORIGIN=http://localhost:5173
# Cloud Run / production public URL (for keep-alive cron)
# PUBLIC_URL=https://agrimart-api-xxxxx.asia-south1.run.app

# ── Google Cloud Run (production) ─────────────────────────────
# Deploy: cd agrimart-backend && .\scripts\deploy-gcp.ps1 -ProjectId YOUR_PROJECT_ID -SetEnvFromDotEnv
# Vertex AI: enable aiplatform.googleapis.com, set GOOGLE_CLOUD_PROJECT
# Local ADC: gcloud auth application-default login

# ── Business Config ─────────────────────────────────────────
PLATFORM_COMMISSION_RATE=0.025
FREE_DELIVERY_ABOVE=500
C